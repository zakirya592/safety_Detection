generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model DetectionAlert {
  id         Int      @id @default(autoincrement())
  time       DateTime @default(now())
  camera     String   @db.NVarChar(100)
  location   String   @db.NVarChar(200)
  event      String   @db.NVarChar(200)
  confidence Float
  image_url  String?  @db.NVarChar(500)
  status     String   @default("New") @db.NVarChar(20)

  @@map("detectionAlert")
}

model EmailNotificationSetting {
  id                   Int      @id @default(1)
  receivingEmail       String   @db.NVarChar(255)
  attachCapturedPhotos Boolean  @default(true)
  enabled              Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("emailNotificationSetting")
}

model EmailNotificationLog {
  id        Int      @id @default(autoincrement())
  event     String   @db.NVarChar(200)
  location  String   @db.NVarChar(200)
  camera    String   @db.NVarChar(100)
  recipient String   @db.NVarChar(255)
  status    String   @default("Delivered") @db.NVarChar(20)
  image_url String?  @db.NVarChar(500)
  createdAt DateTime @default(now())

  @@map("emailNotificationLog")
}
